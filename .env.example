# Token Factory connection
TF_API_KEY=
TF_BASE_URL=https://api.tokenfactory.nebius.com/v1

# Model IDs (confirmed against the live Token Factory catalog on 2026-10-27)
MODEL_NANO=nvidia/NVIDIA-Nemotron-3-Nano-30B-A3B
MODEL_SUPER=nvidia/nemotron-3-super-120b-a12b
MODEL_ULTRA=nvidia/Nemotron-3-Ultra-550b-a55b

# Panel sizing
PERSONA_COUNT=100
# Measured 2026-10-27 at 10/25/50 against pricing_v1.txt, 100 Nano calls
# each: zero 429s at every level tested, so 50 (the highest tested) wins --
# 35.3s elapsed, under the 40s target. See README's Performance section.
MAX_CONCURRENCY=50

# Optional: URL artifact fetch. Without this, fetch.py falls back to
# requests + readability-lxml.
TAVILY_API_KEY=

# --- Public-deployment spend limits (api/main.py) --------------------------
# Not in the build spec. The deployed service is unauthenticated and every
# run spends real credits, so these bound what one caller can do. The
# defaults are generous for a human and useless for a script; omit them
# entirely for local development.
#
# Largest panel a single request may ask for (also capped by pool size).
MAX_PERSONA_COUNT=1000
# Runs allowed to be in flight at once across the whole service.
MAX_CONCURRENT_RUNS=3
# Runs one client IP may start per RATE_LIMIT_WINDOW_S seconds.
RATE_LIMIT_RUNS=20
RATE_LIMIT_WINDOW_S=3600
